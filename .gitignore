# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/server/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production / build artifacts
/build
/dist

# electron-builder output (also covered by /dist, but explicit for safety)
*.dmg
*.dmg.blockmap
*.zip
*.zip.blockmap
*.AppImage
*.exe
*.exe.blockmap
*.deb
*.snap
*.pkg

# OS
.DS_Store
**/.DS_Store

# env
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# Claude Code – lokale/Preview-Konfiguration
# (projektweite .claude/settings.json darf weiterhin eingecheckt werden)
.claude/launch.json
.claude/settings.local.json
